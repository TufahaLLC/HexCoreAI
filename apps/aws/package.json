{
  "name": "hexcore-ai",
  "version": "1.0.0",
  "description": "HexCore AI Serverless Architecture",
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "deploy": "pnpm run build && sam deploy",
    "local": "sam local start-api"
  },
  "dependencies": {
    "@aws-lambda-powertools/event-handler": "2.25.2",
    "@aws-lambda-powertools/idempotency": "^2.27.0",
    "@aws-lambda-powertools/logger": "2.27.0",
    "@aws-lambda-powertools/metrics": "2.26.1",
    "@aws-lambda-powertools/parser": "^2.27.0",
    "@aws-lambda-powertools/tracer": "2.26.1",
    "@aws-sdk/client-apigatewaymanagementapi": "3.899.0",
    "@aws-sdk/client-bedrock-agent": "3.901.0",
    "@aws-sdk/client-bedrock-agent-runtime": "3.891.0",
    "@aws-sdk/client-dynamodb": "3.879.0",
    "@aws-sdk/client-eventbridge": "3.864.0",
    "@aws-sdk/client-s3": "3.892.0",
    "@aws-sdk/client-secrets-manager": "3.883.0",
    "@aws-sdk/client-sqs": "3.901.0",
    "@aws-sdk/lib-dynamodb": "3.878.0",
    "axios": "1.12.2",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.153",
    "@types/node": "^24.6.2",
    "typescript": "^5.9.3"
  }
}
